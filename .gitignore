# Installed by npm; do not commit dependencies.
node_modules/

# Frontend build output from Vite.
/dist/

# Rust/Tauri build artifacts; regenerated by Cargo/Tauri.
src-tauri/target/

# Generated Tauri files; regenerated by Tauri tooling.
src-tauri/gen/

# Local command/build logs.
*.log

# Local demo/reference copy; not part of the app build.
/tiptap-track-demo/
/tiptap-track-demo/**

# Root-level local copy only. Keep vendor/codemirror-lang-typst tracked.
/codemirror-lang-typst/

# Do not ignore vendor/: package.json and src-tauri/Cargo.toml depend on it.
